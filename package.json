{
  "name": "arangates.github.io",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "check-types": "pnpm --filter web check-types",
    "lint": "oxlint apps/web/src",
    "format": "oxfmt --write .",
    "check": "pnpm lint && oxfmt --check .",
    "preview": "node scripts/preview.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "test:pwa": "node --test scripts/service-worker.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
